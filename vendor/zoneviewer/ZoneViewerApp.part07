        context.translate(player.x, player.y);
        context.rotate(direction + Math.PI / 2);
        context.shadowColor = 'rgba(255, 24, 24, .98)';
        context.shadowBlur = 11;
        context.lineJoin = 'round';
        context.beginPath();
        context.moveTo(0, -13);
        context.lineTo(8, 8);
        context.lineTo(0, 5);
        context.lineTo(-8, 8);
