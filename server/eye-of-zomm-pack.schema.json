{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EQLWiki - Eye of Zomm Dataset",
  "type": "object",
  "required": [
    "meta",
    "zones",
    "npcs",
    "items"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "version": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "currentEra": {
          "type": "string"
        },
        "sample": {
          "type": "boolean"
        },
        "lootSourceCountsVersion": {
          "const": 1
        },
        "lootSetsVersion": {
          "const": 1
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "viewerName": {
            "type": "string"
          },
          "wikiTitle": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "zone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "levelMin": {
            "type": "number"
          },
          "levelMax": {
            "type": "number"
          },
          "avgLevel": {
            "type": "number"
          },
          "era": {
            "type": "string"
          },
          "wikiTitle": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "loc": {
            "type": "array",
            "description": "EverQuest displayed location order: Y, X, and optional Z. Normalize at the app coordinate boundary before spatial use.",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "race": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "revisionId": {
            "type": "integer"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "wikiTitle": {
            "type": "string"
          },
          "era": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "description": "Allowed playable class codes; ALL is unrestricted, NONE permits no class, and an empty array is unknown. ALL except is exported as its allowed-class complement.",
            "items": {
              "type": "string"
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "iconId": {
            "type": "integer",
            "minimum": 1
          },
          "displayLines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "dropSources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "zone": {
                  "type": "string"
                }
              }
            }
          },
          "lootSourceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "lootSourceCountComplete": {
            "type": "boolean"
          },
          "lootSourceNpcs": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revisionId": {
            "type": "integer"
          }
        }
      }
    },
    "lootSourceCounts": {
      "type": "object",
      "description": "Canonical item title to distinct global authored NPC loot sources, including statless items and public item redlinks. Incomplete records retain a lower bound only.",
      "additionalProperties": {
        "$ref": "#/$defs/lootSourceCount"
      }
    },
    "lootSets": {
      "type": "object",
      "maxProperties": 5000,
      "description": "Canonical public Gear Set title to explicit canonical members. Complete membership permits source deduplication without name guesses.",
      "additionalProperties": {
        "$ref": "#/$defs/lootSet"
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:image/"
      }
    }
  },
  "$defs": {
    "lootSet": {
      "type": "object",
      "required": [
        "items",
        "complete"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lootSourceCount": {
      "type": "object",
      "required": [
        "lootSourceCount",
        "lootSourceCountComplete",
        "lootSourceNpcs"
      ],
      "properties": {
        "lootSourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "lootSourceCountComplete": {
          "type": "boolean"
        },
        "lootSourceNpcs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
