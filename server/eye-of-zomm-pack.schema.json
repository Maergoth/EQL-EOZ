{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EQLWiki - Eye of Zomm Dataset",
  "type": "object",
  "required": [
    "meta",
    "zones",
    "npcs",
    "items"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "version": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "currentEra": {
          "type": "string"
        },
        "sample": {
          "type": "boolean"
        },
        "lootSourceCountsVersion": {
          "const": 2,
          "description": "Verified real public NPC identities only; redlinks and non-monster pages cannot inflate the lower bound."
        },
        "lootSetsVersion": {
          "const": 1
        },
        "wikiRelationshipCoverageVersion": {
          "const": 1
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "viewerName": {
            "type": "string"
          },
          "viewerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "description": "Explicit preferred archive ID for a display label shared by multiple supported zone archives. A verified logged short name takes precedence."
          },
          "wikiTitle": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "zone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "zoneScope": {
            "const": "various",
            "description": "Exact literal Various zone field on this scoped NPC template; does not create map coordinates."
          },
          "categoryZones": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string"
            },
            "description": "Verified zone categories that drive the normal DynamicZoneList; not spawn/stat or raid identity."
          },
          "levelMin": {
            "type": "number"
          },
          "levelMax": {
            "type": "number"
          },
          "avgLevel": {
            "type": "number"
          },
          "era": {
            "type": "string"
          },
          "wikiTitle": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "loc": {
            "type": "array",
            "description": "EverQuest displayed location order: Y, X, and optional Z. Normalize at the app coordinate boundary before spatial use.",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "race": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "revisionId": {
            "type": "integer"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "wikiTitle": {
            "type": "string"
          },
          "era": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "description": "Allowed playable class codes; ALL is unrestricted, NONE permits no class, and an empty array is unknown. ALL except is exported as its allowed-class complement.",
            "items": {
              "type": "string"
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "iconId": {
            "type": "integer",
            "minimum": 1
          },
          "displayLines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contributionCard": {
            "$ref": "#/$defs/contributionCard"
          },
          "notes": {
            "type": "string"
          },
          "dropSources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "zone": {
                  "type": "string"
                }
              }
            }
          },
          "lootSourceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "lootSourceCountComplete": {
            "type": "boolean"
          },
          "lootSourceNpcs": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revisionId": {
            "type": "integer"
          }
        }
      }
    },
    "lootSourceCounts": {
      "type": "object",
      "description": "Canonical item title to distinct global authored NPC loot sources, including statless items and public item redlinks. Incomplete records retain a lower bound only.",
      "additionalProperties": {
        "$ref": "#/$defs/lootSourceCount"
      }
    },
    "lootSets": {
      "type": "object",
      "maxProperties": 5000,
      "description": "Canonical public Gear Set title to explicit canonical members. Complete membership permits source deduplication without name guesses.",
      "additionalProperties": {
        "$ref": "#/$defs/lootSet"
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:image/"
      }
    },
    "wikiRelationshipCoverage": {
      "type": "object",
      "maxProperties": 100000,
      "additionalProperties": {
        "$ref": "#/$defs/relationshipCoverage"
      }
    }
  },
  "$defs": {
    "contributionCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "schemaVersion", "complete", "questContext" ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "complete": { "type": "boolean" },
        "questContext": { "type": "boolean" }
      },
      "description": "Current public authored Itempage metadata is literal, known and fully represented by the bounded rich card. Quest links are context, not proof of importance. Missing or incomplete proof cannot authorize a quiet routine decision."
    },
    "lootSet": {
      "type": "object",
      "required": [
        "items",
        "complete"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "complete": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/relationshipSource"
        },
        "possibleItems": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "possibleItemsComplete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lootSourceCount": {
      "type": "object",
      "required": [
        "lootSourceCount",
        "lootSourceCountComplete",
        "lootSourceNpcs"
      ],
      "properties": {
        "lootSourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "lootSourceCountComplete": {
          "type": "boolean"
        },
        "lootSourceNpcs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "relationshipSource": {
      "type": "object",
      "required": [
        "wikiTitle",
        "revisionId"
      ],
      "properties": {
        "wikiTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revisionId": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "section": {
          "type": "string",
          "maxLength": 160
        },
        "instance": {
          "enum": [
            "normal",
            "raid"
          ]
        }
      }
    },
    "relationshipScope": {
      "type": "object",
      "required": [
        "field",
        "instance",
        "state"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instance": {
          "enum": [
            "normal",
            "raid"
          ]
        },
        "state": {
          "enum": [
            "exact",
            "broad",
            "unsupported",
            "variant"
          ]
        },
        "zone": {
          "type": "string",
          "maxLength": 240
        },
        "section": {
          "type": "string",
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "maxLength": 96
        },
        "card": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "relationshipEdge": {
      "type": "object",
      "required": [
        "field",
        "instance",
        "source"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instance": {
          "enum": [
            "normal",
            "raid"
          ]
        },
        "zone": {
          "type": "string",
          "maxLength": 240
        },
        "npc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "precision": {
          "enum": [
            "npc",
            "zone-npc"
          ]
        },
        "source": {
          "$ref": "#/$defs/relationshipSource"
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "collectionSource": {
          "$ref": "#/$defs/relationshipSource"
        },
        "verifiedNpc": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "section": {
          "type": "string",
          "maxLength": 160
        },
        "lootKind": {
          "enum": [
            "known",
            "common"
          ]
        }
      }
    },
    "relationshipCollectionRef": {
      "type": "object",
      "required": [
        "title",
        "field",
        "instance",
        "complete",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instance": {
          "enum": [
            "normal",
            "raid"
          ]
        },
        "zone": {
          "type": "string",
          "maxLength": 240
        },
        "complete": {
          "type": "boolean"
        },
        "section": {
          "type": "string",
          "maxLength": 160
        },
        "source": {
          "$ref": "#/$defs/relationshipSource"
        },
        "collectionSource": {
          "$ref": "#/$defs/relationshipSource"
        },
        "items": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "relationshipCoverage": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "wikiTitle",
        "revisionId",
        "state",
        "complete",
        "edges",
        "scopes",
        "collectionRefs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "enum": [
            "item",
            "npc",
            "zone"
          ]
        },
        "wikiTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revisionId": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "exact",
            "broad",
            "unsupported",
            "variant"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 96
        },
        "edges": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/relationshipEdge"
          }
        },
        "scopes": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/relationshipScope"
          }
        },
        "collectionRefs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/relationshipCollectionRef"
          }
        },
        "dynamicLists": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "zone",
              "instance",
              "field"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "instance": {
                "enum": [
                  "normal",
                  "raid"
                ]
              },
              "field": {
                "const": "dynamic_population"
              }
            }
          }
        }
      }
    }
  }
}
