{
  "name": "eqlwiki-eye-of-zomm",
  "productName": "EQLWiki - Eye of Zomm",
  "version": "1.0.13",
  "desktopName": "com.eqlwiki.eyeofzomm.desktop",
  "homepage": "https://github.com/Maergoth/EQL-EOZ",
  "description": "Local-first EQLWiki desktop app for EverQuest Legends logs, maps, NPCs, items, and wiki intelligence.",
  "author": "Maergoth",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "build:workers": "node scripts/prepare-ocr-assets.mjs && node scripts/build-appearance.mjs && node scripts/assemble-zone-viewer.mjs && node scripts/patch-viewer-terrain-indices.mjs && node scripts/build-navmesh-worker.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "prestart": "npm run build:workers",
    "start": "electron .",
    "pretest": "npm run build:workers",
    "test": "node scripts/run-source-tests.mjs",
    "test:catalog": "node scripts/check-catalog-relevance.mjs",
    "fetch:bootstrap": "node scripts/fetch-bootstrap-pack.mjs",
    "predist:win": "npm run build:workers",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "predist:linux": "npm run build:workers",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "test:artifact": "node scripts/check-packaged-artifact.mjs",
    "predist:dir": "npm run build:workers",
    "dist:dir": "electron-builder --dir",
    "test:desktop-worker": "node scripts/test-desktop-worker.mjs",
    "test:native-overlays": "node scripts/test-native-overlays.mjs",
    "test:discovery-notices": "node scripts/test-discovery-notices.mjs",
    "test:discovery-existence": "node tests/wiki-item-existence.mjs && node tests/wiki-discovery-existence.mjs",
    "test:discovery-popup": "node scripts/test-discovery-popup.mjs",
    "test:chat-item-boundaries": "node scripts/test-chat-item-boundaries.mjs",
    "test:discovery-capture-workspace": "node scripts/test-discovery-capture-workspace.mjs",
    "test:window-lifecycle": "node scripts/test-window-lifecycle.mjs",
    "test:map-layout": "node scripts/test-map-layout.mjs && node scripts/test-map-player-marker.mjs",
    "test:map-overlay-3d": "node scripts/test-map-overlay-3d.mjs",
    "test:appearance": "node scripts/test-appearance.mjs",
    "test:system-fonts": "node scripts/test-system-fonts.mjs",
    "test:main-cache": "node scripts/test-main-cache.mjs",
    "test:map-loot": "node scripts/test-map-loot.mjs",
    "test:capture": "node tests/screen-read-parser.mjs && node tests/screen-read-journal.mjs && node tests/capture-host.mjs && node tests/capture-source.mjs && node tests/capture-png-worker.mjs && node tests/capture-reader.mjs && node tests/ocr-service.mjs && node tests/ocr-runtime.mjs && node tests/loot-provenance.mjs && node tests/ocr-offline.mjs",
    "test:wiki-auth": "node scripts/test-wiki-auth.mjs",
    "test:capture-native": "node scripts/test-capture-native.mjs",
    "test:capture-workspace": "node scripts/test-capture-workspace.mjs",
    "pretest:capture": "node scripts/prepare-ocr-assets.mjs",
    "test:capture-calibration": "node scripts/test-capture-calibration.mjs",
    "pretest:modern-ocr": "node scripts/prepare-ocr-assets.mjs",
    "test:modern-ocr": "node tests/modern-ocr.mjs",
    "pretest:default-ocr": "node scripts/prepare-ocr-assets.mjs",
    "test:default-ocr": "node tests/default-ocr.mjs",
    "pretest:hover-ocr": "node scripts/prepare-ocr-assets.mjs",
    "test:hover-ocr": "node tests/hover-ocr.mjs",
    "test:intel-stability": "node scripts/test-intel-stability.mjs",
    "test:overlay-resize": "node scripts/test-overlay-resize.mjs",
    "test:character-walkthrough": "node scripts/test-character-walkthrough.mjs",
    "test:character-screenshot": "node scripts/test-character-screenshot.mjs",
    "test:capture-priority": "node scripts/test-capture-priority.mjs",
    "test:character-storage": "node scripts/test-character-storage.mjs",
    "test:workspace-098": "node scripts/test-098-workspace.mjs",
    "test:spawn-prompt": "node scripts/test-spawn-prompt.mjs",
    "test:consider-level-workspace": "node scripts/test-consider-level-workspace.mjs",
    "test:zone-creation-workspace": "node scripts/test-zone-creation-workspace.mjs",
    "test:workspace-099": "node scripts/test-099-workspace.mjs",
    "sync:item-scaling": "node scripts/sync-item-scaling.mjs",
    "check:item-scaling": "node scripts/sync-item-scaling.mjs --check",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "check:icons": "node scripts/check-app-icons.mjs",
    "test:combatant-overview": "node scripts/test-combatant-overview.mjs",
    "test:screen-reading-master": "node scripts/test-screen-reading-master.mjs",
    "test:map-location-latency": "node scripts/test-map-location-latency.mjs",
    "test:discovery-queue-stability": "node scripts/test-discovery-queue-stability.mjs",
    "test:character-repository": "node scripts/test-character-repository.mjs",
    "test:feature-controls": "node scripts/test-feature-controls-workspace.mjs",
    "test:drop-observations-native": "node scripts/test-drop-observation-sqlite-runtime.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "recast-navigation": "0.43.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "build": {
    "appId": "com.eqlwiki.eyeofzomm",
    "productName": "EQLWiki - Eye of Zomm",
    "asar": true,
    "compression": "maximum",
    "extraResources": [
      {
        "from": ".generated",
        "to": ".",
        "filter": [
          "ocr-runtime/**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "LICENSE",
      "THIRD_PARTY/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "eqlwiki-eye-of-zomm",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Maergoth",
      "artifactName": "EQLWiki-Eye-of-Zomm-${version}-x64.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EQLWiki - Eye of Zomm",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "EQLWiki-Eye-of-Zomm-Setup-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "EQLWiki - Eye of Zomm",
        "schemes": [
          "eqleoz"
        ]
      }
    ]
  }
}
