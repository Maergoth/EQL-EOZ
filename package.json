{
  "name": "eqlwiki-eye-of-zomm",
  "productName": "EQLWiki - Eye of Zomm",
  "version": "0.3.0",
  "description": "Local-first EQLWiki companion for EverQuest Legends: logs, maps, NPCs, items, and wiki intelligence.",
  "author": "Maergoth",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test.mjs && node --check desktop/main.cjs && node --check app/app.js && node --check app/parser.js && node --check app/item-scaling.js && node --check app/con-colors.js",
    "fetch:bootstrap": "node scripts/fetch-bootstrap-pack.mjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.eqlwiki.eyeofzomm",
    "productName": "EQLWiki - Eye of Zomm",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "LICENSE",
      "THIRD_PARTY/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EQLWiki - Eye of Zomm",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "EQLWiki-Eye-of-Zomm-Setup-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "EQLWiki - Eye of Zomm",
        "schemes": [
          "eqleoz"
        ]
      }
    ]
  }
}
